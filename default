server {
    listen 80 default_server;
    listen [::]:80 default_server;

    root /var/www/html;

    # Priorizamos index.php para que Nginx ejecute tu código
    index index.php index.html index.htm;

    server_name _;

    location / {
        try_files $uri $uri/ =404;
    }

    # Bloque de PHP limpio y apuntando al socket real que vimos con ls
    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php8.3-fpm.sock;
    }
}
